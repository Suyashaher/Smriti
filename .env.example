# Copy to .env and fill in locally. Never commit .env.

# MongoDB — local only; FastAPI is the only client
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=eldercare_ai

# JWT — generate strong values for local/dev; rotate for any shared demo
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_HOST=127.0.0.1
API_PORT=8000

# CORS — Vite origin in Phase 2 (adjust if the port differs)
CORS_ORIGINS=http://localhost:5173

# App
APP_VERSION=0.1.0
